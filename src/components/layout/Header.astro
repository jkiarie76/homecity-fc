---
import "../../styles/header.css";

export interface Props {
    activePage?: string;
}

const { activePage = "" } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const currentPage = activePage || (
    currentPath === "/" ? "home" :
    currentPath.startsWith("/about") ? "about" :
    currentPath.startsWith("/senior-team") ? "senior-team" :
    currentPath.startsWith("/academies") ? "academies" :
    currentPath.startsWith("/women-team") ? "women-team" :
    currentPath.startsWith("/match-center") ? "match-center" :
    currentPath.startsWith("/news") ? "news" :
    currentPath.startsWith("/fan-shop") ? "fan-shop" :
    currentPath.startsWith("/partners") ? "partners" :
    currentPath.startsWith("/contact") ? "contact" :
    currentPath.startsWith("/support") ? "support" : ""
);

const aboutPages = [
    "about",
    "overview",
    "senior-team",
    "academies",
    "women-team"
];

const aboutActive = aboutPages.includes(currentPage);
---

<header class="hc-header">
    <div class="hc-nav-container">

        <!-- LOGO -->
        <a href="/" class="hc-logo" aria-label="Homecity FC homepage">
            <img
                src="/images/home-city-fc-logo-44.svg"
                alt="Homecity FC logo"
                width="52"
                height="52"
            />
            <span class="hc-logo-text">
                <strong>HOMECITY</strong>
                <span>FOOTBALL CLUB</span>
            </span>
        </a>

        <!-- MOBILE MENU TOGGLE -->
        <button
            class="hc-menu-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="hc-navigation"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <!-- NAVIGATION -->
        <nav class="hc-navigation" id="hc-navigation" aria-label="Main navigation">
            <ul class="hc-nav-list">

                <li class="hc-nav-item">
                    <a
                        href="/"
                        class:list={[
                            "hc-nav-link",
                            { active: currentPage === "home" }
                        ]}
                        aria-current={currentPage === "home" ? "page" : undefined}
                    >
                        Home
                    </a>
                </li>

                <!-- ABOUT US DROPDOWN -->
                <li class:list={[
                    "hc-nav-item",
                    "hc-dropdown",
                    { "dropdown-active": aboutActive }
                ]}>
                    <button
                        class="hc-nav-link hc-dropdown-toggle"
                        type="button"
                        aria-expanded="false"
                        aria-haspopup="true"
                    >
                        About Us
                        <svg
                            class="hc-chevron"
                            viewBox="0 0 20 20"
                            width="14"
                            height="14"
                            fill="none"
                            aria-hidden="true"
                        >
                            <path
                                d="m5 7 5 5 5-5"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                    </button>

                    <ul class="hc-dropdown-menu">
                        <li>
                            <a
                                href="/about"
                                class:active={currentPage === "about" || currentPage === "overview"}
                                aria-current={(currentPage === "about" || currentPage === "overview") ? "page" : undefined}
                            >
                                Overview
                            </a>
                        </li>
                        <li>
                            <a
                                href="/senior-team"
                                class:active={currentPage === "senior-team"}
                                aria-current={currentPage === "senior-team" ? "page" : undefined}
                            >
                                Senior Team
                            </a>
                        </li>
                        <li>
                            <a
                                href="/academies"
                                class:active={currentPage === "academies"}
                                aria-current={currentPage === "academies" ? "page" : undefined}
                            >
                                Academies
                            </a>
                        </li>
                        <li>
                            <a
                                href="/women-team"
                                class:active={currentPage === "women-team"}
                                aria-current={currentPage === "women-team" ? "page" : undefined}
                            >
                                Women Team
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="hc-nav-item">
                    <a
                        href="/match-center"
                        class:list={[
                            "hc-nav-link",
                            { active: currentPage === "match-center" }
                        ]}
                        aria-current={currentPage === "match-center" ? "page" : undefined}
                    >
                        Match Center
                    </a>
                </li>


                <li class="hc-nav-item">
                    <a
                        href="/news"
                        class:list={[
                            "hc-nav-link",
                            { active: currentPage === "news" }
                        ]}
                        aria-current={currentPage === "news" ? "page" : undefined}
                    >
                        News
                    </a>
                </li>

                <li class="hc-nav-item">
                    <a
                        href="/fan-shop"
                        class:list={[
                            "hc-nav-link",
                            { active: currentPage === "fan-shop" }
                        ]}
                        aria-current={currentPage === "fan-shop" ? "page" : undefined}
                    >
                        Fan Shop
                    </a>
                </li>

                <li class="hc-nav-item">
                    <a
                        href="/partners"
                        class:list={[
                            "hc-nav-link",
                            { active: currentPage === "partners" }
                        ]}
                        aria-current={currentPage === "partners" ? "page" : undefined}
                    >
                        Partners
                    </a>
                </li>

                <li class="hc-nav-item">
                    <a
                        href="/contact"
                        class:list={[
                            "hc-nav-link",
                            { active: currentPage === "contact" }
                        ]}
                        aria-current={currentPage === "contact" ? "page" : undefined}
                    >
                        Contact Us
                    </a>
                </li>

                <!-- SUPPORT US CTA: LINKS TO ITS OWN PAGE -->
                <li class="hc-nav-item hc-support-item">
                    <a
                        href="/support"
                        class:list={[
                            "hc-support-btn",
                            { "support-active": currentPage === "support" }
                        ]}
                        aria-current={currentPage === "support" ? "page" : undefined}
                    >
                        Support Us
                        <span aria-hidden="true">↗</span>
                    </a>
                </li>

            </ul>
        </nav>
    </div>
</header>
<script src="/header.js" is:inline></script>