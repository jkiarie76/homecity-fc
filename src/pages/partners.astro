---
import "../styles/partners.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Partners | Homecity FC"
    description="Partner with Homecity FC and become part of a football community driven by ambition, development and impact."
    activePage="partners"
>

    <!-- ================= HERO ================= -->

    <section class="partners-hero">

        <img
            class="partners-hero-image"
            src="/images/matchday.png"
            alt=""
            aria-hidden="true"
        />

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <span class="hero-label">
                HOMECITY FC
            </span>

            <h1>
                BUILDING<br>
                <span>TOGETHER.</span>
            </h1>

            <p>
                Partner with Homecity FC and become part of a football
                community driven by ambition, development and impact.
            </p>

            <a href="#partnerships" class="hero-button">
                EXPLORE PARTNERSHIPS
                <i class="fas fa-arrow-down"></i>
            </a>

        </div>

        <div class="hero-scroll">

            <span>
                SCROLL TO EXPLORE
            </span>

            <i class="fas fa-chevron-down"></i>

        </div>

    </section>


    <!-- ================= INTRO ================= -->

    <section class="partners-intro">

        <div class="container intro-grid">

            <div class="intro-heading">

                <span class="section-label">
                    PARTNER WITH HOMECITY
                </span>

                <h2>
                    MORE THAN<br>
                    A <span>SPONSOR.</span>
                </h2>

            </div>

            <div class="intro-text">

                <p>
                    Homecity FC is building a football club that connects
                    sport, community and opportunity.
                </p>

                <p>
                    Our partners are not simply logos on a shirt. They are
                    part of the journey and help us create experiences,
                    develop young talent and grow the Homecity community.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= PARTNERSHIP OPPORTUNITIES ================= -->

    <section
        class="partnership-section"
        id="partnerships"
    >

        <div class="container">

            <div class="section-heading">

                <div>

                    <span class="section-label">
                        PARTNERSHIP OPPORTUNITIES
                    </span>

                    <h2>
                        FIND YOUR<br>
                        <span>PLACE.</span>
                    </h2>

                </div>

                <p>
                    Flexible partnership opportunities designed to connect
                    businesses and organisations with the Homecity audience.
                </p>

            </div>


            <div class="partnership-grid">

                <!-- MAIN PARTNER -->

                <article class="partnership-card featured">

                    <div class="card-number">
                        01
                    </div>

                    <div class="card-icon">
                        <i class="fas fa-shirt"></i>
                    </div>

                    <span class="card-label">
                        PREMIUM
                    </span>

                    <h3>
                        MAIN<br>
                        PARTNER
                    </h3>

                    <p>
                        High-visibility partnership opportunities across
                        key Homecity FC platforms and matchday experiences.
                    </p>

                    <ul>

                        <li>
                            <i class="fas fa-check"></i>
                            Brand visibility
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Matchday exposure
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Digital presence
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Community activation
                        </li>

                    </ul>

                </article>


                <!-- ACADEMY -->

                <article class="partnership-card">

                    <div class="card-number">
                        02
                    </div>

                    <div class="card-icon">
                        <i class="fas fa-child"></i>
                    </div>

                    <span class="card-label">
                        DEVELOPMENT
                    </span>

                    <h3>
                        ACADEMY<br>
                        PARTNER
                    </h3>

                    <p>
                        Support the development of young footballers while
                        associating your brand with youth development.
                    </p>

                    <ul>

                        <li>
                            <i class="fas fa-check"></i>
                            Academy visibility
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Youth programmes
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Community initiatives
                        </li>

                    </ul>

                </article>


                <!-- MATCHDAY -->

                <article class="partnership-card">

                    <div class="card-number">
                        03
                    </div>

                    <div class="card-icon">
                        <i class="fas fa-futbol"></i>
                    </div>

                    <span class="card-label">
                        EXPERIENCE
                    </span>

                    <h3>
                        MATCHDAY<br>
                        PARTNER
                    </h3>

                    <p>
                        Connect your brand with the energy and excitement
                        surrounding Homecity FC matchdays.
                    </p>

                    <ul>

                        <li>
                            <i class="fas fa-check"></i>
                            Matchday branding
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Fan engagement
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Event activation
                        </li>

                    </ul>

                </article>


                <!-- COMMUNITY -->

                <article class="partnership-card">

                    <div class="card-number">
                        04
                    </div>

                    <div class="card-icon">
                        <i class="fas fa-people-group"></i>
                    </div>

                    <span class="card-label">
                        COMMUNITY
                    </span>

                    <h3>
                        COMMUNITY<br>
                        PARTNER
                    </h3>

                    <p>
                        Work with Homecity on initiatives that create
                        meaningful impact within the community.
                    </p>

                    <ul>

                        <li>
                            <i class="fas fa-check"></i>
                            Community projects
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Grassroots football
                        </li>

                        <li>
                            <i class="fas fa-check"></i>
                            Social impact
                        </li>

                    </ul>

                </article>

            </div>

        </div>

    </section>


    <!-- ================= BENEFITS ================= -->

    <section class="benefits-section">

        <div class="container">

            <div class="section-heading center">

                <span class="section-label">
                    WHY HOMECITY
                </span>

                <h2>
                    YOUR BRAND.<br>
                    <span>OUR PLATFORM.</span>
                </h2>

                <p>
                    Partnerships can create meaningful connections between
                    brands, football and the Homecity community.
                </p>

            </div>


            <div class="benefits-grid">

                <div class="benefit">

                    <div class="benefit-icon">
                        <i class="fas fa-bullhorn"></i>
                    </div>

                    <h3>
                        BRAND VISIBILITY
                    </h3>

                    <p>
                        Put your brand in front of players, supporters,
                        families and the wider Homecity community.
                    </p>

                </div>


                <div class="benefit">

                    <div class="benefit-icon">
                        <i class="fas fa-users"></i>
                    </div>

                    <h3>
                        COMMUNITY
                    </h3>

                    <p>
                        Build authentic relationships through football,
                        grassroots programmes and community initiatives.
                    </p>

                </div>


                <div class="benefit">

                    <div class="benefit-icon">
                        <i class="fas fa-mobile-screen-button"></i>
                    </div>

                    <h3>
                        DIGITAL REACH
                    </h3>

                    <p>
                        Connect with the Homecity audience through digital
                        content, campaigns and club platforms.
                    </p>

                </div>


                <div class="benefit">

                    <div class="benefit-icon">
                        <i class="fas fa-handshake"></i>
                    </div>

                    <h3>
                        ACTIVATION
                    </h3>

                    <p>
                        Create campaigns and experiences that bring your
                        brand closer to football supporters.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= PARTNER WALL ================= -->

    <section class="partner-wall">

        <div class="container">

            <div class="section-heading center">

                <span class="section-label">
                    OUR PARTNERS
                </span>

                <h2>
                    POWERED BY<br>
                    <span>PARTNERS.</span>
                </h2>

                <p>
                    The organisations and brands supporting the Homecity
                    FC journey.
                </p>

            </div>


            <div class="logo-grid">

                <div class="partner-logo">
                    <span>PARTNER</span>
                    <small>01</small>
                </div>

                <div class="partner-logo">
                    <span>PARTNER</span>
                    <small>02</small>
                </div>

                <div class="partner-logo">
                    <span>PARTNER</span>
                    <small>03</small>
                </div>

                <div class="partner-logo">
                    <span>PARTNER</span>
                    <small>04</small>
                </div>

                <div class="partner-logo">
                    <span>PARTNER</span>
                    <small>05</small>
                </div>

                <div class="partner-logo">
                    <span>PARTNER</span>
                    <small>06</small>
                </div>

            </div>

        </div>

    </section>


    <!-- ================= COMMUNITY ================= -->

    <section class="community-section">

        <div class="community-image">

            <img
                src="/images/fans.png"
                alt="Homecity FC supporters"
            >

        </div>

        <div class="community-content">

            <span class="section-label">
                BEYOND FOOTBALL
            </span>

            <h2>
                CREATING<br>
                <span>IMPACT.</span>
            </h2>

            <p>
                Homecity FC believes football can create opportunities
                beyond the pitch. Through partnerships, we can support
                youth development, grassroots football and initiatives
                that bring people together.
            </p>

            <div class="community-points">

                <div>
                    <strong>01</strong>
                    <span>Youth Development</span>
                </div>

                <div>
                    <strong>02</strong>
                    <span>Grassroots Football</span>
                </div>

                <div>
                    <strong>03</strong>
                    <span>Community Engagement</span>
                </div>

            </div>

        </div>

    </section>

<br>
    <!-- ================= CTA ================= -->

    <section class="partner-cta">

        <img
            class="cta-image"
            src="/images/hfc1.png"
            alt=""
            aria-hidden="true"
        />

        <div class="cta-overlay"></div>

        <div class="container cta-content">

            <span class="section-label">
                LET'S BUILD TOGETHER
            </span>

            <h2>
                YOUR BRAND<br>
                <span>STARTS HERE.</span>
            </h2>

            <p>
                Talk to the Homecity FC team about partnership,
                sponsorship and collaboration opportunities.
            </p>

            <div class="cta-buttons">

                <a
                    href="mailto:info@homecityfc.com"
                    class="btn-primary"
                >
                    BECOME A PARTNER
                    <i class="fas fa-arrow-right"></i>
                </a>

                <a
                    href="tel:+254700000000"
                    class="btn-outline"
                >
                    <i class="fas fa-phone"></i>
                    TALK TO US
                </a>

            </div>

        </div>

    </section>

</BaseLayout>