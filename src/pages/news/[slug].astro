
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import "../../styles/news.css";

const newsItems = await getCollection(
    "news",
    ({ data }) => data.status === "published"
);

export async function getStaticPaths() {
    const newsItems = await getCollection(
        "news",
        ({ data }) => data.status === "published"
    );

    return newsItems.map((entry) => ({
        params: { slug: entry.data.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const item = {
    ...entry.data,
    slug: entry.data.slug,
};

const { Content } = await render(entry);

const formatDate = (dateString: string | undefined) => {
    if (!dateString) return "";

    return new Date(`${dateString}T12:00:00Z`).toLocaleDateString(
        "en-GB",
        {
            day: "numeric",
            month: "long",
            year: "numeric",
            timeZone: "UTC",
        }
    );
};

const getCategory = (newsItem: {
    type: "story" | "event" | "memo";
    eventDate?: string;
}) => {
    if (newsItem.type === "story") return "Stories";
    if (newsItem.type === "memo") return "Memos";
    if (!newsItem.eventDate) return "Upcoming Events";

    const today = new Date().toISOString().slice(0, 10);

    return newsItem.eventDate < today
        ? "Past Events"
        : "Upcoming Events";
};
---


<BaseLayout
    title={`${item.title} | Homecity FC`}
    description={item.summary}
    activePage="news"
>
    <main class="news-article">
        <article class="news-article-container">
            <nav class="news-breadcrumbs" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <span aria-hidden="true"> / </span>
                <a href="/news">News &amp; Updates</a>
                <span aria-hidden="true"> / </span>
                <span aria-current="page">{item.title}</span>
            </nav>

            <header class="news-article-header">
                <span class="news-category">
                    {getCategory(item)}
                </span>

                <h1>{item.title}</h1>

                <p class="news-article-summary">{item.summary}</p>

                <div class="news-card-meta">
                    <span>
                        Published {formatDate(item.publishedAt)}
                    </span>
                </div>
            </header>

            <figure class="news-article-cover">
                <img
                    src={item.image}
                    alt={item.title}
                    loading="eager"
                />
            </figure>

            {
                item.type === "event" && (
                    <section
                        class="news-event-details"
                        aria-label="Event details"
                    >
                        {item.eventDate && (
                            <div class="news-event-detail">
                                <strong>Date</strong>
                                <span>{formatDate(item.eventDate)}</span>
                            </div>
                        )}

                        {item.eventTime && (
                            <div class="news-event-detail">
                                <strong>Time</strong>
                                <span>{item.eventTime}</span>
                            </div>
                        )}

                        {item.venue && (
                            <div class="news-event-detail">
                                <strong>Venue</strong>
                                <span>{item.venue}</span>
                            </div>
                        )}
                    </section>
                )
            }

            <div class="news-article-body">
                <Content />
            </div>

            {
                item.tags?.length > 0 && (
                    <div class="news-tags" aria-label="Article tags">
                        {item.tags.map((tag) => (
                            <span class="news-tag">#{tag}</span>
                        ))}
                    </div>
                )
            }

            <a class="news-back-link" href="/news">
                <span aria-hidden="true">←</span>
                Back to News &amp; Updates
            </a>
        </article>
    </main>
</BaseLayout>
