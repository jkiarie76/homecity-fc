
---
import Layout from "../layouts/BaseLayout.astro";
import "../styles/contact.css";

const teamOptions = [
  { value: "general", label: "General Inquiry" },
  { value: "senior", label: "Senior Team" },
  { value: "partnerships", label: "Partnerships / Sponsorships" },
  { value: "women", label: "Women's Team" },
  { value: "under-7", label: "Under-7 Academy" },
  { value: "under-9", label: "Under-9 Academy" },
  { value: "under-11", label: "Under-11 Academy" },
  { value: "under-13", label: "Under-13 Academy" },
  { value: "under-15", label: "Under-15 Academy" },
  { value: "under-17", label: "Under-17 Academy" },
];

const requestedTeam = Astro.url.searchParams.get("team") ?? "general";

const selectedTeam = teamOptions.some(
  (team) => team.value === requestedTeam
)
  ? requestedTeam
  : "general";
---

<Layout title="Contact Us | Homecity FC">
  <main class="contact-page">

    <section class="contact-hero">
      <div class="contact-container">
        <span class="contact-eyebrow">
          HOME CITY. ONE FAMILY.
        </span>

        <h1>
          Let's Talk <span>Football.</span>
        </h1>

        <p>
          Have a question, want to join the club, or looking to
          build a partnership? We're ready to hear from you.
        </p>

        <div class="contact-hero-line"></div>
      </div>
    </section>

    <section class="contact-section">
      <div class="contact-container contact-grid">

        <aside class="contact-info">
          <span class="contact-label">GET IN TOUCH</span>

          <h2>
            Every great connection starts with a conversation.
          </h2>

          <p class="contact-info-description">
            Whether you're a player, parent, supporter, or potential
            partner, Homecity FC welcomes your inquiry.
          </p>

          <div class="contact-info-list">

            <div class="contact-info-item">
              <div class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"
                    stroke="currentColor" stroke-width="1.7"/>
                  <circle cx="12" cy="9" r="2.5"
                    stroke="currentColor" stroke-width="1.7"/>
                </svg>
              </div>

              <div>
                <h3>Our Club</h3>
                <p>Homecity Football Club</p>
                <span>Football. Community. Opportunity.</span>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="5" width="18" height="14" rx="2"
                    stroke="currentColor" stroke-width="1.7"/>
                  <path d="m4 7 8 6 8-6"
                    stroke="currentColor" stroke-width="1.7"
                    stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>

              <div>
                <h3>General Inquiries</h3>
                <p>Use the contact form</p>
                <span>Tell us what you need help with.</span>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="9"
                    stroke="currentColor" stroke-width="1.7"/>
                  <path d="M12 7v5l3 2"
                    stroke="currentColor" stroke-width="1.7"
                    stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>

              <div>
                <h3>What Happens Next?</h3>
                <p>Your inquiry goes to the club</p>
                <span>We'll follow up using the contact details you provide.</span>
              </div>
            </div>

          </div>

          <div class="contact-note">
            <span class="contact-note-mark" aria-hidden="true">HC</span>
            <p>
              <strong>One club. One community.</strong>
              <br />
              Thank you for being part of the Homecity FC journey.
            </p>
          </div>
        </aside>

        <div class="contact-form-card">
          <div class="contact-form-heading">
            <span class="contact-label">SEND US A MESSAGE</span>
            <h2>How can we help?</h2>
            <p>Complete the form below and share your inquiry with us.</p>
          </div>

          <form
            class="contact-form"
            action="https://formspree.io/f/YOUR_FORM_ID"
            method="POST"
          >
            <input
              type="hidden"
              name="_subject"
              value="New Homecity FC Website Inquiry"
            />

            <div class="contact-field">
              <label for="contact-name">Full Name <span>*</span></label>
              <input
                id="contact-name"
                type="text"
                name="name"
                autocomplete="name"
                placeholder="e.g. John Kamau"
                required
              />
            </div>

            <div class="contact-form-row">
              <div class="contact-field">
                <label for="contact-email">Email Address <span>*</span></label>
                <input
                  id="contact-email"
                  type="email"
                  name="email"
                  autocomplete="email"
                  placeholder="you@example.com"
                  required
                />
              </div>

              <div class="contact-field">
                <label for="contact-phone">Phone Number <span>*</span></label>
                <input
                  id="contact-phone"
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  placeholder="+254 7XX XXX XXX"
                  required
                />
              </div>
            </div>

            <div class="contact-field">
              <label for="contact-team">Inquiry Type <span>*</span></label>
              <select id="contact-team" name="team" required>
                {teamOptions.map((team) => (
                  <option
                    value={team.value}
                    selected={selectedTeam === team.value}
                  >
                    {team.label}
                  </option>
                ))}
              </select>
            </div>

            <div class="contact-field">
              <label for="contact-message">Your Message <span>*</span></label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                placeholder="Tell us a little more about your inquiry..."
                required
              ></textarea>
            </div>

            <button class="contact-submit" type="submit">
              <span>Send Inquiry</span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6"
                  stroke="currentColor" stroke-width="1.8"
                  stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <p class="contact-form-footnote">
              <span aria-hidden="true">*</span> Required fields
            </p>
          </form>
        </div>

      </div>
    </section>

  </main>
</Layout>
