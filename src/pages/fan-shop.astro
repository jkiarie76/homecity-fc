
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import "../styles/fan-shop.css";

const settingsEntry = await getEntry("fanShop", "fan-shop");

if (!settingsEntry) {
  throw new Error(
    "Fan Shop settings are missing: src/content/settings/fan-shop.md"
  );
}

const settings = settingsEntry.data;

const products = (
  await getCollection(
    "products",
    ({ data }) => data.status === "published"
  )
).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const categories = [
  ...new Set(
    products.map(({ data }) => data.category).filter(Boolean)
  ),
];
---

<BaseLayout title="Fan Shop | Homecity FC" activePage="fan-shop">
  <main class="commerce-page shop-page">

    <!-- HERO SECTION -->
    <section class="commerce-hero">
      <div class="commerce-container commerce-hero-inner">
        <p class="eyebrow">{settings.heroEyebrow}</p>

        <h1>
          {settings.heroTitle}
          <span>{settings.heroHighlight}</span>
        </h1>

        <p>{settings.heroDescription}</p>

        <a
          class="button button-primary"
          href={settings.heroButtonUrl}
        >
          {settings.heroButtonText}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- PRODUCT COLLECTION -->
    <section
      class="commerce-container shop-content"
      id="shop-products"
    >
      <!-- COLLECTION HEADING -->
      <div class="shop-heading-row">
        <div>
          <p class="eyebrow">{settings.collectionEyebrow}</p>
          <h2>{settings.collectionTitle}</h2>
          <p class="muted">{settings.collectionDescription}</p>
        </div>
      </div>

      <!-- ORDERING NOTICE -->
      {settings.showOrderingNotice && (
        <p class="muted">{settings.orderingNotice}</p>
      )}

      <!-- PRODUCT SEARCH, CATEGORY FILTER AND SORTING -->
      <div class="shop-toolbar">
        <label class="search-field">
          <span class="sr-only">Search products</span>
          <span aria-hidden="true">⌕</span>
          <input
            id="shop-search"
            type="search"
            placeholder="Search the collection…"
            autocomplete="off"
          />
        </label>

        <label class="filter-field">
          <span class="sr-only">Filter by category</span>
          <select id="shop-category">
            <option value="all">All categories</option>
            {categories.map((category) => (
              <option value={category}>{category}</option>
            ))}
          </select>
        </label>

        <label class="filter-field">
          <span class="sr-only">Sort products</span>
          <select id="shop-sort">
            <option value="featured">Featured</option>
            <option value="price-low">Price: low to high</option>
            <option value="price-high">Price: high to low</option>
            <option value="name">Name: A–Z</option>
          </select>
        </label>
      </div>

      <!-- PRODUCT GRID -->
      {products.length > 0 ? (
        <div class="shop-product-grid" id="shop-product-grid">
          {products.map(({ data }) => (
            <article
              class="product-card"
              data-product-id={data.slug}
              data-category={data.category ?? "Other"}
              data-name={data.title.toLowerCase()}
              data-price={data.price}
            >
              <div class="product-image-wrap">
                <img
                  class="product-image"
                  src={data.image}
                  alt={data.title}
                  loading="lazy"
                />

                <span class="product-category">
                  {data.category ?? "Homecity FC"}
                </span>
              </div>

              <div class="product-details">
                <h3>{data.title}</h3>

                <p class="product-description">
                  {data.description || "Official Homecity FC merchandise."}
                </p>

                <div class="product-buy-row">
                  <strong class="product-price">
                    KES {data.price.toLocaleString("en-KE")}
                  </strong>

                  <button
                    class="button button-add"
                    type="button"
                    disabled={data.stockStatus === "out-of-stock"}
                    data-add-to-cart
                    data-product-id={data.slug}
                    aria-label={
                      data.stockStatus === "out-of-stock"
                        ? `${data.title} is out of stock`
                        : `Purchasing ${data.title} is coming soon`
                    }
                  >
                    {data.stockStatus === "out-of-stock"
                      ? "Out of Stock"
                      : "Coming Soon"}
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-products">
          {settings.emptyProductsMessage}
        </p>
      )}

      <!-- SEARCH RESULTS MESSAGE -->
      <p class="empty-products" id="shop-no-results" hidden>
        No products match your search. Try another term or category.
      </p>
    </section>

    <!-- NOTIFICATION -->
    <div
      class="shop-toast"
      id="shop-toast"
      role="status"
      aria-live="polite"
      hidden
    >
      <span id="shop-toast-message">
        Online purchasing is coming soon.
      </span>

      <button
        type="button"
        id="shop-toast-close"
        aria-label="Dismiss notification"
      >
        ×
      </button>
    </div>

  </main>

  <script src="/shop.js" defer></script>
</BaseLayout>
