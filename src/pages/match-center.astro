                    <div class="fixture-teams">

                        <strong>
                            HOMECITY FC
                        </strong>

                        <span>
                            VS
                        </span>

                        <strong>
                            ESTATE STARS FC
                        </strong>

                    </div>


                    <div class="fixture-time">
                        3:00 PM
                    </div>


                    <div class="fixture-venue">
                        KIPARA GROUNDS
                    </div>

                </article>

            </div>

        </div>

    </section>


