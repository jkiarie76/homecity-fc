                            </strong>

                            <span>
                                VS
                            </span>

                            <strong>
                                THIKA CITY FC
                            </strong>

                        </div>

                        <p>
                            <i class="fas fa-location-dot"></i>
                            Kipara Grounds
                        </p>

                    </div>


                    <div class="friendly-time">

                        <strong>
                            3:00 PM
                        </strong>

                        <span>
                            HOME
                        </span>

                    </div>

                </article>


                <!-- Friendly 2 -->

                <article class="friendly-card">

                    <div class="friendly-date">

                        <strong>
                            02
                        </strong>

                        <span>
                            OCT<br />
