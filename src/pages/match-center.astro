---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/match-center.css";
---

<BaseLayout
    title="Match Center | Homecity FC"
    description="Fixtures, results and league standings — follow every Homecity FC match."
    activePage="match-center"
>

    <!-- =========================================================
         PAGE HERO
         ========================================================== -->

    <section
        class="page-hero"
        style="background-image: url('/images/matchday.png');"
    >

        <div class="page-hero-overlay"></div>

        <div class="page-hero-content">

            <span class="page-label">
                MATCH CENTRE
            </span>

            <h1>
                FOLLOW THE <span>ACTION.</span>
            </h1>

            <p>
                Stay up to date with Homecity FC fixtures,
                results, friendlies and league standings.
            </p>

        </div>

    </section>


    <!-- =========================================================
         NEXT MATCH
         ========================================================== -->

    <section class="next-match-section">

        <div class="section-container">

            <div class="section-heading">

                <span>
                    NEXT MATCH
                </span>

                <h2>
                    THE NEXT BATTLE
                </h2>

            </div>


            <div class="next-match-card">

                <div class="match-date">

                    <span>
                        SUNDAY
                    </span>

                    <strong>
                        27
                    </strong>

                    <span>
                        SEPTEMBER 2026
                    </span>

                </div>


                <div class="match-teams">

                    <div class="team home-team">

                        <div class="team-name">
                            HOMECITY FC
                        </div>

                        <span>
                            HOME
                        </span>

                    </div>


                    <div class="match-vs">

                        <strong>
                            VS
                        </strong>

                        <span>
                            3:00 PM
                        </span>

                    </div>


                    <div class="team away-team">

                        <div class="team-name">
                            THIKA UNITED B
                        </div>

                        <span>
                            AWAY
                        </span>

                    </div>

                </div>


                <div class="match-details">

                    <span>
                        <i class="fas fa-trophy"></i>
                        FKF REGIONAL LEAGUE
                    </span>

                    <span>
                        <i class="fas fa-location-dot"></i>
                        KIPARA GROUNDS, KISII ESTATE, THIKA
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         LATEST RESULTS
         ========================================================== -->

    <section class="results-section">

        <div class="section-container">

            <div class="section-heading">

                <span>
                    LATEST RESULTS
                </span>

                <h2>
                    HOW WE'VE DONE
                </h2>

            </div>


            <div class="results-grid">

                <!-- Result 1 -->

                <article class="result-card">

                    <div class="result-date">

                        <strong>
                            20
                        </strong>

                        <span>
                            SEP<br />
                            2026
                        </span>

                    </div>


                    <div class="result-teams">

                        <strong>
                            HOMECITY FC
                        </strong>

                        <span>
                            3 - 1
                        </span>

                        <strong>
                            RIVALS FC
                        </strong>

                    </div>


                    <div class="result-status win">
                        WIN
                    </div>


                    <div class="result-venue">
                        KIPARA GROUNDS
                    </div>

                </article>


                <!-- Result 2 -->

                <article class="result-card">

                    <div class="result-date">

                        <strong>
                            13
                        </strong>

                        <span>
                            SEP<br />
                            2026
                        </span>

                    </div>


                    <div class="result-teams">

                        <strong>
                            HOMECITY FC
                        </strong>

                        <span>
                            2 - 0
                        </span>

                        <strong>
                            ESTATE STARS
                        </strong>

                    </div>


                    <div class="result-status win">
                        WIN
                    </div>


                    <div class="result-venue">
                        KIPARA GROUNDS
                    </div>

                </article>


                <!-- Result 3 -->

                <article class="result-card">

                    <div class="result-date">

                        <strong>
                            06
                        </strong>

                        <span>
                            SEP<br />
                            2026
                        </span>

                    </div>


                    <div class="result-teams">

                        <strong>
                            HOMECITY FC
                        </strong>

                        <span>
                            1 - 1
                        </span>

                        <strong>
                            KIAMBU WARRIORS
                        </strong>

                    </div>


                    <div class="result-status draw">
                        DRAW
                    </div>


                    <div class="result-venue">
                        AWAY
                    </div>

                </article>

            </div>

        </div>

    </section>


