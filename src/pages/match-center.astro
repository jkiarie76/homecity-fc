---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/match-center.css";
---

<!--
  Static Match Centre page.
  All match information below is hardcoded for now.
  Replace the sample teams, scores, dates, venues and standings manually.
  BaseLayout supplies the shared site header and footer.
-->

<BaseLayout
    title="Match Centre | Homecity FC"
    description="Fixtures, results and league standings — follow every Homecity FC match."
    activePage="match-center"
>
<!-- PAGE HERO -->
<section class="page-hero" style="background-image: url('/images/matchday.png');">
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
        <span class="page-label">MATCH CENTRE</span>
        <h1>FOLLOW THE <span>ACTION.</span></h1>
        <p>Stay up to date with Homecity FC fixtures, results, friendlies and league standings.</p>
    </div>
</section>

<!-- NEXT MATCH -->
<section class="next-match-section">
    <div class="section-container">
        <div class="section-heading">
            <span>NEXT MATCH</span>
            <h2>THE NEXT BATTLE</h2>
        </div>

        <div class="next-match-card">
            <div class="match-date">
                <span>SATURDAY</span>
                <strong>07</strong>
                <span>NOV 2026</span>
            </div>

            <div class="match-teams">
                <div class="team home-team">
                    <div class="team-name">Homecity FC</div>
                    <span>HOME</span>
                </div>

                <div class="match-vs">
                    <strong>VS</strong>
                    <span>3:00 PM</span>
                </div>

                <div class="team away-team">
                    <div class="team-name">Thika United</div>
                    <span>AWAY TEAM</span>
                </div>
            </div>

            <div class="match-details">
                <span><i class="fas fa-trophy"></i> Thika League</span>
                <span><i class="fas fa-location-dot"></i> Kipara Grounds</span>
            </div>
        </div>
    </div>
</section>

<!-- LATEST RESULTS -->
<section class="results-section">
    <div class="section-container">
        <div class="section-heading">
            <span>LATEST RESULTS</span>
            <h2>HOW WE'VE DONE</h2>
        </div>

        <div class="results-grid">
            <article class="result-card">
                <div class="result-date">
                    <strong>18</strong>
                    <span>OCT<br />2026</span>
                </div>
                <div class="result-teams">
                    <strong>Homecity FC</strong>
                    <span>2 - 1</span>
                    <strong>Makongeni FC</strong>
                </div>
                <div class="result-status win">WIN</div>
                <div class="result-venue">Kipara Grounds</div>
                <a href="/news">Read Match Report</a>
            </article>

            <article class="result-card">
                <div class="result-date">
                    <strong>11</strong>
                    <span>OCT<br />2026</span>
                </div>
                <div class="result-teams">
                    <strong>Thika United</strong>
                    <span>1 - 1</span>
                    <strong>Homecity FC</strong>
                </div>
                <div class="result-status draw">DRAW</div>
                <div class="result-venue">Thika Stadium</div>
                <a href="/news">Read Match Report</a>
            </article>

            <article class="result-card">
                <div class="result-date">
                    <strong>04</strong>
                    <span>OCT<br />2026</span>
                </div>
                <div class="result-teams">
                    <strong>Homecity FC</strong>
                    <span>0 - 1</span>
                    <strong>Juja Rangers</strong>
                </div>
                <div class="result-status loss">LOSS</div>
                <div class="result-venue">Kipara Grounds</div>
                <a href="/news">Read Match Report</a>
            </article>
        </div>
    </div>
</section>

<!-- FRIENDLIES -->
<section class="friendlies-section">
    <div class="section-container">
        <div class="section-heading">
            <span>PRE-SEASON &amp; SPECIAL MATCHES</span>
            <h2>FRIENDLIES</h2>
        </div>

        <div class="friendlies-grid">
            <article class="friendly-card">
                <div class="friendly-date">
                    <strong>14</strong>
                    <span>NOV<br />2026</span>
                </div>
                <div class="friendly-details">
                    <span class="friendly-label">FRIENDLY</span>
                    <div class="friendly-teams">
                        <strong>Homecity FC</strong>
                        <span>VS</span>
                        <strong>Ruiru Stars</strong>
                    </div>
                    <p><i class="fas fa-location-dot"></i> Kipara Grounds</p>
                </div>
                <div class="friendly-time">
                    <strong>10:00 AM</strong>
                    <span>HOME</span>
                </div>
            </article>

            <article class="friendly-card">
                <div class="friendly-date">
                    <strong>21</strong>
                    <span>NOV<br />2026</span>
                </div>
                <div class="friendly-details">
                    <span class="friendly-label">FRIENDLY</span>
                    <div class="friendly-teams">
                        <strong>Githurai FC</strong>
                        <span>VS</span>
                        <strong>Homecity FC</strong>
                    </div>
                    <p><i class="fas fa-location-dot"></i> Githurai Grounds</p>
                </div>
                <div class="friendly-time">
                    <strong>2:00 PM</strong>
                    <span>AWAY</span>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- UPCOMING FIXTURES -->
<section class="fixtures-section">
    <div class="section-container">
        <div class="section-heading">
            <span>WHAT'S COMING</span>
            <h2>UPCOMING FIXTURES</h2>
        </div>

        <div class="fixtures-list">
            <article class="fixture-row">
                <div class="fixture-date">
                    <strong>07</strong>
                    <span>NOV<br />2026</span>
                </div>
                <div class="fixture-teams">
                    <strong>Homecity FC</strong>
                    <span>VS</span>
                    <strong>Thika United</strong>
                </div>
                <div class="fixture-time">3:00 PM</div>
                <div class="fixture-venue">
                    Kipara Grounds
                    <p>Thika League</p>
                </div>
            </article>

            <article class="fixture-row">
                <div class="fixture-date">
                    <strong>28</strong>
                    <span>NOV<br />2026</span>
                </div>
                <div class="fixture-teams">
                    <strong>Juja Rangers</strong>
                    <span>VS</span>
                    <strong>Homecity FC</strong>
                </div>
                <div class="fixture-time">2:00 PM</div>
                <div class="fixture-venue">
                    Juja Grounds
                    <p>Thika League</p>
                </div>
            </article>

            <article class="fixture-row">
                <div class="fixture-date">
                    <strong>05</strong>
                    <span>DEC<br />2026</span>
                </div>
                <div class="fixture-teams">
                    <strong>Homecity FC</strong>
                    <span>VS</span>
                    <strong>Makongeni FC</strong>
                </div>
                <div class="fixture-time">3:00 PM</div>
                <div class="fixture-venue">
                    Kipara Grounds
                    <p>Thika League</p>
                </div>
            </article>
        </div>

        <div class="fixture-notices">
            <p><strong>POSTPONED:</strong> Homecity FC vs Example Opponent — Sat, 12 Dec 2026</p>
        </div>
    </div>
</section>

<!-- LEAGUE TABLE -->
<section class="table-section">
    <div class="section-container">
        <div class="section-heading">
            <span>LEAGUE STANDINGS</span>
            <h2>THE TABLE</h2>
            <p>Thika League · 2026/27</p>
        </div>

        <div class="table-wrapper">
            <table class="league-table">
                <thead>
                    <tr>
                        <th>POS</th>
                        <th>TEAM</th>
                        <th>P</th>
                        <th>W</th>
                        <th>D</th>
                        <th>L</th>
                        <th>GD</th>
                        <th>PTS</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="homecity-row">
                        <td>1</td>
                        <td><strong>Homecity FC</strong></td>
                        <td>8</td>
                        <td>6</td>
                        <td>1</td>
                        <td>1</td>
                        <td>+10</td>
                        <td><strong>19</strong></td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td><strong>Thika United</strong></td>
                        <td>8</td>
                        <td>5</td>
                        <td>2</td>
                        <td>1</td>
                        <td>+7</td>
                        <td><strong>17</strong></td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td><strong>Juja Rangers</strong></td>
                        <td>8</td>
                        <td>4</td>
                        <td>2</td>
                        <td>2</td>
                        <td>+4</td>
                        <td><strong>14</strong></td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td><strong>Makongeni FC</strong></td>
                        <td>8</td>
                        <td>3</td>
                        <td>2</td>
                        <td>3</td>
                        <td>0</td>
                        <td><strong>11</strong></td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td><strong>Ruiru Stars</strong></td>
                        <td>8</td>
                        <td>2</td>
                        <td>1</td>
                        <td>5</td>
                        <td>-6</td>
                        <td><strong>7</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- MATCHDAY CTA -->
<section class="matchday-cta" style="background-image: url('/images/matchday.png');">
    <div class="cta-overlay"></div>
    <div class="cta-content">
        <span>MATCHDAY IS BETTER TOGETHER</span>
        <h2>SEE YOU AT KIPARA.</h2>
        <p>Bring the energy. Bring the passion. Stand with Homecity FC.</p>
        <a href="/support" class="cta-button">
            SUPPORT THE CLUB
            <i class="fas fa-arrow-right"></i>
        </a>
    </div>
</section>
</BaseLayout>
