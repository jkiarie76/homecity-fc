
---
import Layout from "../layouts/BaseLayout.astro";
import "../styles/women-team.css";
---

<Layout title="Women's Football | Homecity FC">
    <main class="women-page">

        <!-- HERO -->
        <section class="women-hero">
            <div class="women-hero-overlay"></div>

            <div class="women-container women-hero-content">
                <span class="women-eyebrow">
                    HOMECITY FC · WOMEN'S FOOTBALL
                </span>

                <h1>
                    THE FUTURE
                    <span>STARTS HERE.</span>
                </h1>

                <p class="women-hero-description">
                    We're building towards a future where women have more
                    opportunities to play, grow, and compete through football.
                    Be part of the journey.
                </p>

                <div class="women-hero-actions">
                    <a href="/contact" class="women-btn women-btn-primary">
                        Express Your Interest
                    </a>

                    <a href="#our-vision" class="women-btn women-btn-outline">
                        Discover Our Vision
                    </a>
                </div>

                <div class="women-hero-note">
                    <span class="women-status-dot"></span>
                    WOMEN'S FOOTBALL INITIATIVE · TEAM FORMATION IN PROGRESS
                </div>
            </div>
        </section>

        <!-- VISION -->
        <section class="women-vision women-section" id="our-vision">
            <div class="women-container women-vision-grid">
                <div class="women-vision-heading">
                    <span class="women-eyebrow">OUR VISION</span>

                    <h2>
                        More Opportunities.
                        <span>More Possibilities.</span>
                    </h2>
                </div>

                <div class="women-vision-copy">
                    <p>
                        At Homecity FC, we believe football should create
                        opportunities for talent to thrive. Our ambition is
                        to develop a platform that encourages women to
                        participate, develop their abilities, and pursue
                        their football goals.
                    </p>

                    <p>
                        We are working towards building the foundations
                        for women's football at Homecity. With the right
                        players, people, and support, we want to turn that
                        ambition into an opportunity.
                    </p>

                    <p class="women-vision-highlight">
                        The journey begins with a vision. The future is
                        built together.
                    </p>
                </div>
            </div>
        </section>

        <!-- WHAT WE WANT TO BUILD -->
        <section class="women-opportunity women-section">
            <div class="women-container">
                <div class="women-section-heading">
                    <span class="women-eyebrow">THE OPPORTUNITY</span>
                    <h2>Building Something <span>Meaningful.</span></h2>
                    <p>
                        Our ambition is to create an environment where
                        women can grow through football.
                    </p>
                </div>

                <div class="women-opportunity-grid">
                    <article class="women-opportunity-card">
                        <span class="women-card-number">01</span>
                        <div class="women-card-icon" aria-hidden="true">⚽</div>
                        <h3>Develop Talent</h3>
                        <p>
                            Create opportunities for women to pursue their
                            passion, strengthen their skills, and grow as
                            footballers.
                        </p>
                    </article>

                    <article class="women-opportunity-card">
                        <span class="women-card-number">02</span>
                        <div class="women-card-icon" aria-hidden="true">🤝</div>
                        <h3>Build Community</h3>
                        <p>
                            Bring players, coaches, supporters, and partners
                            together around a shared commitment to women's
                            football.
                        </p>
                    </article>

                    <article class="women-opportunity-card">
                        <span class="women-card-number">03</span>
                        <div class="women-card-icon" aria-hidden="true">🏆</div>
                        <h3>Create Opportunity</h3>
                        <p>
                            Work towards building the foundations for a
                            women's team with the people and support needed
                            to move forward.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <!-- PLAYER INTEREST -->
        <section class="women-players women-section" id="players">
            <div class="women-container women-players-grid">
                <div class="women-players-content">
                    <span class="women-eyebrow">FOR ASPIRING PLAYERS</span>

                    <h2>
                        Have a Passion
                        <span>for Football?</span>
                    </h2>

                    <p>
                        If you're a woman who wants to play football and
                        would like to hear about future opportunities at
                        Homecity FC, we'd love to hear from you.
                    </p>

                    <p>
                        Get in touch to express your interest and let the
                        club know you'd like to be part of the journey.
                    </p>

                    <a href="/contact" class="women-btn women-btn-primary">
                        Register Your Interest
                    </a>

                    <p class="women-small-note">
                        Expressing interest does not guarantee selection
                        or confirm that recruitment has opened.
                    </p>
                </div>

                <div class="women-players-visual">
                    <div class="women-visual-frame">
                        <img
                            src="/images/women/women-football-training.jpg"
                            alt="Women playing football during a training session"
                            loading="lazy"
                        />

                        <div class="women-visual-caption">
                            <span>YOUR PASSION.</span>
                            <strong>YOUR OPPORTUNITY.</strong>
                        </div>
                    </div>
                    <div class="women-visual-accent"></div>
                </div>
            </div>
        </section>

        <!-- PARTNERS -->
        <section class="women-partners women-section">
            <div class="women-container women-partners-grid">
                <div>
                    <span class="women-eyebrow">FOR SPONSORS & PARTNERS</span>

                    <h2>
                        Help Build
                        <span>the Future.</span>
                    </h2>
                </div>

                <div class="women-partners-copy">
                    <p>
                        Establishing a women's football team takes commitment,
                        planning, resources, and people who believe in the
                        opportunity.
                    </p>

                    <p>
                        If you are a potential sponsor, coach, volunteer, or
                        organisation interested in supporting the development
                        of women's football at Homecity FC, we invite you to
                        start a conversation with us.
                    </p>

                    <a href="/contact" class="women-btn women-btn-outline">
                        Discuss a Partnership
                    </a>
                </div>
            </div>
        </section>

        <!-- CLOSING CTA -->
        <section class="women-closing">
            <div class="women-closing-overlay"></div>

            <div class="women-container women-closing-content">
                <span class="women-eyebrow">A NEW CHAPTER AHEAD</span>

                <h2>
                    The Game Is for
                    <span>Everyone.</span>
                </h2>

                <p>
                    Help us create more opportunities for women through
                    football. Every conversation is a step towards the future.
                </p>

                <a href="/contact" class="women-btn women-btn-primary">
                    Be Part of the Journey
                </a>

                <p class="women-closing-signoff">
                    HOMECITY FC · BUILDING OPPORTUNITIES THROUGH FOOTBALL
                </p>
            </div>
        </section>

    </main>
</Layout>
