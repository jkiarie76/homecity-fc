                            <span>
                                VS
                            </span>

                            <strong>
                                HOMECITY FC
                            </strong>

                        </div>

                        <p>
                            <i class="fas fa-location-dot"></i>
                            Ruiru Stadium
                        </p>

                    </div>


                    <div class="friendly-time">

                        <strong>
                            4:00 PM
                        </strong>

                        <span>
                            AWAY
                        </span>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- =========================================================
         UPCOMING FIXTURES
         ========================================================== -->

    <section class="fixtures-section">

        <div class="section-container">

            <div class="section-heading">

