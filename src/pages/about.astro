---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../../src/styles/about.css";
---

<BaseLayout
    title="About Us | Homecity FC"
    description="Learn about Homecity FC, our story, vision, values, leadership and commitment to the community."
    activePage="about"
>

    <!-- =========================================================
         HERO
    ========================================================== -->

    <section
        class="about-hero"
        style="background-image: url('/images/hfc1.png');"
    >

        <div class="hero-overlay"></div>

        <div class="about-hero-content">

            <span class="hero-label">
                <i class="fas fa-shield-halved"></i>
                THE HOME OF HOMECITY FC
            </span>

            <h1>
                MORE THAN<br>
                <span>FOOTBALL.</span>
            </h1>

            <p>
                A club built around football, community, ambition
                and the belief that our greatest journey is still ahead.
            </p>

        </div>

        <div class="hero-scroll">

            <span>DISCOVER HOMECITY</span>

            <i class="fas fa-chevron-down"></i>

        </div>

    </section>


    <!-- =========================================================
         WHO WE ARE
    ========================================================== -->

    <section
        class="identity-section"
        id="overview"
    >

        <div class="section-container identity-grid">

            <div class="identity-heading">

                <span class="section-label">
                    01 — WHO WE ARE
                </span>

                <h2>
                    THIS IS
                    <span>HOMECITY.</span>
                </h2>

            </div>

            <div class="identity-content">

                <p class="lead">
                    Homecity FC is a football club driven by ambition,
                    community and a passion for the beautiful game.
                </p>

                <p>
                    From the players who represent the badge on matchday
                    to the supporters who stand behind the team, Homecity
                    is built around a shared belief that football can bring
                    people together and create meaningful opportunities.
                </p>

                <p>
                    Our journey is about developing talent, competing with
                    purpose and creating a club that the community can
                    proudly call its own.
                </p>

                <div class="identity-signature">

                    <strong>
                        ONE CLUB. ONE DREAM.
                    </strong>

                    <span>
                        HOME CITY FC
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         OUR STORY
    ========================================================== -->

    <section
        class="story-section"
        id="story"
    >

        <div class="section-container">

            <div class="section-heading">

                <span class="section-label">
                    02 — OUR STORY
                </span>

                <h2>
                    EVERY CLUB HAS
                    <span>A BEGINNING.</span>
                </h2>

                <p>
                    Our story is still being written.
                </p>

            </div>


            <div class="story-layout">

                <div class="story-image">

                    <img
                        src="/images/academy.png"
                        alt="Homecity FC academy players"
                        loading="lazy"
                    />

                    <div class="image-caption">

                        <span>
                            HOMECITY FC
                        </span>

                        <strong>
                            THE JOURNEY CONTINUES
                        </strong>

                    </div>

                </div>


                <div class="story-content">

                    <div class="story-line"></div>

                    <article class="story-block">

                        <span>
                            THE BEGINNING
                        </span>

                        <h3>
                            BUILT FROM THE COMMUNITY
                        </h3>

                        <p>
                            Homecity FC grew from a shared passion for
                            football and a desire to create something
                            meaningful within the community.
                        </p>

                    </article>


                    <article class="story-block">

                        <span>
                            THE JOURNEY
                        </span>

                        <h3>
                            GROWING WITH PURPOSE
                        </h3>

                        <p>
                            As the club continues to develop, every match,
                            every player and every supporter becomes part
                            of the Homecity story.
                        </p>

                    </article>


                    <article class="story-block">

                        <span>
                            THE FUTURE
                        </span>

                        <h3>
                            THE BEST IS STILL AHEAD
                        </h3>

                        <p>
                            Our ambition is to build a sustainable football
                            club that develops talent, competes at a high
                            level and leaves a lasting impact.
                        </p>

                    </article>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         VISION & VALUES
    ========================================================== -->

    <section
        class="vision-section"
        id="values"
    >

        <div class="section-container">

            <div class="vision-header">

                <div>

                    <span class="section-label">
                        03 — OUR IDENTITY
                    </span>

                    <h2>
                        WHAT DRIVES
                        <span>US.</span>
                    </h2>

                </div>

                <p>
                    Football is what brings us together.
                    Purpose is what keeps us moving forward.
                </p>

            </div>


            <div class="values-grid">

                <div class="value-card">

                    <span class="value-number">
                        01
                    </span>

                    <i class="fas fa-eye"></i>

                    <h3>
                        VISION
                    </h3>

                    <p>
                        To build a respected football club that develops
                        talent, competes with ambition and creates lasting
                        value for the community.
                    </p>

                </div>


                <div class="value-card">

                    <span class="value-number">
                        02
                    </span>

                    <i class="fas fa-bullseye"></i>

                    <h3>
                        MISSION
                    </h3>

                    <p>
                        To provide players with opportunities to grow,
                        compete and express themselves through football.
                    </p>

                </div>


                <div class="value-card">

                    <span class="value-number">
                        03
                    </span>

                    <i class="fas fa-handshake"></i>

                    <h3>
                        UNITY
                    </h3>

                    <p>
                        Players, coaches, management and supporters move
                        forward together as one club.
                    </p>

                </div>


                <div class="value-card">

                    <span class="value-number">
                        04
                    </span>

                    <i class="fas fa-arrow-trend-up"></i>

                    <h3>
                        AMBITION
                    </h3>

                    <p>
                        We challenge ourselves to improve, compete and
                        build towards a bigger future.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         MANAGEMENT
    ========================================================== -->

    <section
        class="management-section"
        id="leadership"
    >

        <div class="section-container">

            <div class="section-heading management-heading">

                <span class="section-label">
                    04 — CLUB LEADERSHIP
                </span>

                <h2>
                    THE PEOPLE
                    <span>BEHIND THE CLUB.</span>
                </h2>

                <p>
                    Meet the leadership team helping guide Homecity FC
                    on and off the pitch.
                </p>

            </div>


            <div class="management-grid">

                <article class="management-card">

                    <div class="management-image">

                        <img
                            src="/images/Chairman.jpg"
                            alt="Evans Mwangi, Club Chairman"
                            loading="lazy"
                        />

                        <div class="management-number">
                            01
                        </div>

                    </div>

                    <div class="management-info">

                        <span>
                            CLUB CHAIRMAN
                        </span>

                        <h3>
                            Evans Mwangi
                        </h3>

                        <p>
                            Club chairman since inception, Evans Mwangi
                            has been instrumental in Homecity FC.
                        </p>

                    </div>

                </article>


                <article class="management-card">

                    <div class="management-image">

                        <img
                            src="/images/manager.jpg"
                            alt="Daggie Pinto, General Manager"
                            loading="lazy"
                        />

                        <div class="management-number">
                            02
                        </div>

                    </div>

                    <div class="management-info">

                        <span>
                            GENERAL MANAGER
                        </span>

                        <h3>
                            Daggie Pinto
                        </h3>

                        <p>
                            He is the General Manager of Homecity FC
                            and has been instrumental in the growth
                            of Homecity FC.
                        </p>

                    </div>

                </article>


                <article class="management-card">

                    <div class="management-image">

                        <img
                            src="/images/Technical.jpg"
                            alt="Bonface Karanja, Technical Director"
                            loading="lazy"
                        />

                        <div class="management-number">
                            03
                        </div>

                    </div>

                    <div class="management-info">

                        <span>
                            TECHNICAL DIRECTOR
                        </span>

                        <h3>
                            Bonface Karanja
                        </h3>

                        <p>
                            He is the Technical Director of Homecity FC
                            and has been instrumental in the growth
                            of Homecity FC.
                        </p>

                    </div>

                </article>


                <article class="management-card">

                    <div class="management-image">

                        <img
                            src="/images/coach.jpg"
                            alt="Daglus Kamau, Head Coach"
                            loading="lazy"
                        />

                        <div class="management-number">
                            04
                        </div>

                    </div>

                    <div class="management-info">

                        <span>
                            HEAD COACH
                        </span>

                        <h3>
                            Daglus Kamau
                        </h3>

                        <p>
                            Coach Daglus Kamau has been instrumental in
                            the growth of Homecity FC and has been a key
                            figure in the development of the team.
                        </p>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- =========================================================
         COMMUNITY
    ========================================================== -->

    <section
        class="community-section"
        id="community"
        style="background-image: url('/images/fans.png');"
    >

        <div class="community-overlay"></div>

        <div class="section-container community-content">

            <span class="section-label">
                05 — OUR COMMUNITY
            </span>

            <h2>
                HOME IS
                <span>WHERE WE BELONG.</span>
            </h2>

            <p>
                Homecity FC represents more than the 90 minutes on the pitch.
                We want football to create connections, inspire young people
                and give our community something to believe in.
            </p>

            <div class="community-points">

                <div>
                    <i class="fas fa-users"></i>
                    <span>COMMUNITY</span>
                </div>

                <div>
                    <i class="fas fa-child"></i>
                    <span>YOUTH</span>
                </div>

                <div>
                    <i class="fas fa-futbol"></i>
                    <span>FOOTBALL</span>
                </div>

                <div>
                    <i class="fas fa-heart"></i>
                    <span>PASSION</span>
                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         FINAL CTA
    ========================================================== -->

    <section class="about-cta">

        <div class="section-container">

            <span class="section-label">
                ONE CLUB. ONE DREAM.
            </span>

            <h2>
                THIS IS
                <span>HOMECITY.</span>
            </h2>

            <p>
                Follow the journey. Wear the badge.
                Stand with the club.
            </p>

            <div class="cta-buttons">

                <a
                    href="/support"
                    class="primary-btn"
                >
                    SUPPORT THE CLUB
                    <i class="fas fa-heart"></i>
                </a>

                <a
                    href="/fan-shop"
                    class="secondary-btn"
                >
                    VISIT FAN SHOP
                    <i class="fas fa-arrow-right"></i>
                </a>

            </div>

        </div>

    </section>

</BaseLayout>